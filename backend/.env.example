# ==============================================================================
# FREIXO AI — Backend API Configuration (.env.example)
# Copia este ficheiro para .env e preenche com os valores do teu ambiente
# ==============================================================================

# Servidor Express
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Serviço de IA (FastAPI / Ollama)
FASTAPI_URL=http://127.0.0.1:8000

# Supabase (MANTIDO EXCLUSIVAMENTE NO SERVIDOR — NUNCA EXPÔR AO FRONTEND)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key
