# URL Base da API Node.js / Express
PUBLIC_API_URL=http://localhost:5000/api

# URL do Microserviço Python / FastAPI (Opcional, preferencialmente acedido via Gateway Node.js)
PUBLIC_FASTAPI_URL=http://localhost:8000
